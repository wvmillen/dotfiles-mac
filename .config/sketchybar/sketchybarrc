PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
ITEM_DIR="$HOME/.config/sketchybar/items"

source $HOME/.config/sketchybar/colors.sh
source $HOME/.config/sketchybar/icons.sh

export FONT="Figtree"
export NERD_FONT="SFMono Nerd Font"

sketchybar --bar height=30        \
                 position=top     \
                 padding_left=10  \
                 padding_right=10 \
                 color=0x00000000 \
                 shadow=off

sketchybar --default updates=when_shown                       \
                     drawing=on                               \
                     icon.font="$FONT:Bold:14.0"      \
                     icon.color=0xff2E2E2E              \
                     label.color=0xff2E2E2E              \
                     label.padding_left=4                     \
                     label.padding_right=4                    \
                     icon.padding_left=4                      \
                     icon.padding_right=4 \
                     label.font="$FONT:Bold:14.0"

sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=0x50282828 \
        background.corner_radius=5 \
        background.height=20 \
        background.drawing=off \
        icon.drawing=off \
        width=25 \
        label.font="$FONT:Bold:14.0" \
        label.align=center \
        label.padding_left=9 \
        label.padding_right=0 \
        background.height=22 \
        background.padding_left=6 \
        background.padding_right=6 \
        background.corner_radius=8 \
        label="$sid" \
        label.color=0xffebdbb2 \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
done

SPACE_ITEMS=""
for sid in $(aerospace list-workspaces --all); do
  SPACE_ITEMS="$SPACE_ITEMS space.$sid"
done

sketchybar --add bracket spaces.bubble $SPACE_ITEMS \
  --set spaces.bubble \
       background.drawing=on \
       background.color=0x50282828 \
       background.border_color=0x741E1E1E \
       background.border_width=1 \
       background.corner_radius=12 \
       background.height=24 \
       background.padding_left=8 \
       background.padding_right=8 \
       blur_radius=20

source $ITEM_DIR/window_title.sh
source $ITEM_DIR/clock.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/wifi.sh
source $ITEM_DIR/darkside.sh

sketchybar --update

echo "sketchybar configuration loaded.."
